+package net.createmod.catnip.api.client.render;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import net.minecraft.client.renderer.StagedVertexBuffer;
+import net.minecraft.client.renderer.rendertype.RenderType;
+
+/** Immediate geometry backed by 26.2's native GPU staging and prepared render types. */
+@FunctionalInterface
+public interface RenderBufferSource {
+    VertexConsumer getBuffer(RenderType type);
+
+    final class Immediate implements RenderBufferSource, AutoCloseable {
+        private final Map<RenderType, Batch> batches = new LinkedHashMap<>();
+        @Override public VertexConsumer getBuffer(RenderType type) {
+            Batch batch = batches.computeIfAbsent(type, Batch::new);
+            if (batch.draw == null) {
+                batch.draw = batch.staging.appendDraw(type.format(), type.primitiveTopology(),
+                        type.sortOnUpload() ? RenderSystem.getProjectionType().vertexSorting() : null);
+            }
+            return batch.staging.getVertexBuilder(batch.draw);
+        }
+        public void endBatch() { batches.forEach(this::flush); }
+        public void endBatch(RenderType type) {
+            Batch batch = batches.get(type);
+            if (batch != null) flush(type, batch);
+        }
+        private void flush(RenderType type, Batch batch) {
+            if (batch.draw == null) return;
+            try {
+                batch.staging.upload();
+                var info = batch.staging.getExecuteInfo(batch.draw);
+                if (info != null) type.prepare().drawFromBuffer(info);
+            } finally {
+                batch.draw = null;
+                batch.staging.endFrame();
+            }
+        }
+        @Override public void close() {
+            batches.values().forEach(batch -> batch.staging.close());
+            batches.clear();
+        }
+        private static final class Batch {
+            final StagedVertexBuffer staging;
+            StagedVertexBuffer.Draw draw;
+            Batch(RenderType type) {
+                staging = new StagedVertexBuffer(() -> "Catnip " + type, RenderType.SMALL_BUFFER_SIZE);
+            }
+        }
+    }
+}
