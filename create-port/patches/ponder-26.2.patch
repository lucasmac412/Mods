+package net.createmod.catnip.api.client.render;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.RenderBuffers;
+import net.minecraft.client.renderer.SubmitNodeStorage;
+import net.minecraft.client.renderer.feature.FeatureRenderDispatcher;
+
+/** A separate frame/buffer owner for immediate overlays during an active world frame. */
+public final class IsolatedFeatureRenderer {
+    private static RenderBuffers buffers;
+    private static FeatureRenderDispatcher renderer;
+    private IsolatedFeatureRenderer() { }
+    public static void render(SubmitNodeStorage queue) {
+        if (renderer == null) {
+            var client = Minecraft.getInstance();
+            buffers = new RenderBuffers(0);
+            renderer = new FeatureRenderDispatcher(buffers, client.getModelManager(), client.getAtlasManager(),
+                    client.font, client.gameRenderer.gameRenderState());
+        }
+        try { renderer.renderAllFeatures(queue); }
+        finally { buffers.endFrame(); }
+    }
+    public static void close() {
+        if (renderer != null) {
+            renderer.close();
+            buffers.fixedBufferPack().close();
+            buffers.close();
+            renderer = null;
+            buffers = null;
+        }
+    }
+}
