+/** Preserve the old global blend semantics with the 26.2 per-attachment cache. */
+public final class BlendState {
+    private BlendState() { }
+    private static final class Limits {
+        // The game's indexed blend cache has eight slots; query only with a live GL context.
+        static final int DRAW_BUFFERS = Math.min(8, GL11.glGetInteger(GL20.GL_MAX_DRAW_BUFFERS));
+    }
+    public static void enable() {
+        for (int i = 0, count = Limits.DRAW_BUFFERS; i < count; i++) {
+            GlStateManager._enableBlend(i);
+        }
+    }
+    public static void disable() {
+        for (int i = 0, count = Limits.DRAW_BUFFERS; i < count; i++) {
+            GlStateManager._disableBlend(i);
+        }
+    }
+}
